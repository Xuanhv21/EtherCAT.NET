<Window x:Class="EtherCAT.NET.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EtherCAT.NET"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type local:MainWindowViewModel}}"
        Title="EtherCAT.NET -- Milestone 1 Bring-Up" Height="620" Width="920"
        MinHeight="480" MinWidth="720">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: ESI folder (any vendor's *.xml ESI files, scanned by EsiCatalog.LoadFolder) -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <TextBlock Text="ESI Folder:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
                <Button DockPanel.Dock="Right" Content="Rescan" Margin="6,0,0,0" Padding="10,3"
                        Command="{Binding RescanEsiFolderCommand}" />
                <Button DockPanel.Dock="Right" Content="Browse..." Margin="6,0,0,0" Padding="10,3"
                        Command="{Binding BrowseEsiFolderCommand}" />
                <TextBox Text="{Binding EsiFolderPath, Mode=OneWay}" IsReadOnly="True" Background="WhiteSmoke"
                         Padding="4,2" VerticalAlignment="Center" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding EsiCatalogSummary}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="Gray" />
        </StackPanel>

        <!-- Row 1: adapter picker + Start/Stop -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="Adapter:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
            <ComboBox DockPanel.Dock="Left" Width="420" VerticalAlignment="Center"
                      ItemsSource="{Binding Adapters}"
                      SelectedItem="{Binding SelectedAdapter}"
                      DisplayMemberPath="Description"
                      IsEnabled="{Binding CanEditAdapterSelection}" />
            <Button DockPanel.Dock="Left" Content="Refresh" Margin="6,0,0,0" Padding="10,3"
                    Command="{Binding RefreshAdaptersCommand}" />
            <Button DockPanel.Dock="Right" Content="Stop" Margin="6,0,0,0" Padding="16,3" FontWeight="Bold"
                    Command="{Binding StopCommand}" />
            <Button DockPanel.Dock="Right" Content="Start" Padding="16,3" FontWeight="Bold"
                    Command="{Binding StartCommand}" />
        </DockPanel>

        <!-- Row 2: adapter enumeration error (e.g. Npcap not installed) -->
        <TextBlock Grid.Row="2" Margin="0,0,0,8" Foreground="Red" TextWrapping="Wrap"
                   Text="{Binding AdapterError}" />

        <!-- Row 3: AL state -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="AL State:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Text="{Binding AlStateText}" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0" />
            <TextBlock Text="Data fresh:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <CheckBox IsChecked="{Binding IsDataFresh, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Row 4: slave picker, populated once discovery succeeds; the Statusword panel and the
             five Controlword buttons below always act on whichever one is selected here, never the
             whole group at once. -->
        <DockPanel Grid.Row="4" Margin="0,0,0,10" LastChildFill="True">
            <TextBlock Text="Controlling slave:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" />
            <ComboBox Width="360" HorizontalAlignment="Left" VerticalAlignment="Center"
                      ItemsSource="{Binding Slaves}"
                      SelectedItem="{Binding SelectedSlave}" />
        </DockPanel>

        <!-- Row 5: Statusword indicators + DS402 Controlword buttons (of the selected slave), side by side -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Statusword (0x6041) -- selected slave" Margin="0,0,6,0">
                <UniformGrid Columns="2" Margin="6">
                    <CheckBox Content="Ready to switch on" IsChecked="{Binding ReadyToSwitchOn, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" />
                    <CheckBox Content="Switched on" IsChecked="{Binding SwitchedOn, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" />
                    <CheckBox Content="Operation enabled" IsChecked="{Binding OperationEnabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" />
                    <CheckBox Content="Fault" IsChecked="{Binding Fault, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" Foreground="Red" FontWeight="Bold" />
                    <CheckBox Content="Voltage enabled" IsChecked="{Binding VoltageEnabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" />
                    <CheckBox Content="Quick stop" IsChecked="{Binding QuickStop, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" />
                    <CheckBox Content="Switch on disabled" IsChecked="{Binding SwitchOnDisabled, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" />
                    <CheckBox Content="Warning" IsChecked="{Binding Warning, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="2" Foreground="DarkOrange" FontWeight="Bold" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Controlword (0x6040) -- selected slave" Margin="6,0,0,0">
                <StackPanel Margin="6">
                    <!-- Servo ON/OFF: convenience wrapper around the full DS402 sequence; see
                         MainWindowViewModel.ServoOnAsync. Servo OFF is just Disable Voltage,
                         immediate. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Servo ON" Padding="20,8" Margin="0,0,6,0" FontWeight="Bold"
                                Background="#FF2E7D32" Foreground="White"
                                Command="{Binding ServoOnCommand}" />
                        <Button Content="Servo OFF" Padding="20,8" FontWeight="Bold"
                                Background="#FFC62828" Foreground="White"
                                Command="{Binding ServoOffCommand}" />
                    </StackPanel>
                    <TextBlock Text="Servo ON sequence in progress..." Foreground="DarkOrange" Margin="0,0,0,6"
                               Visibility="{Binding IsServoSequenceRunning, Converter={StaticResource BoolToVisibility}}" />

                    <Separator Margin="0,0,0,8" />
                    <TextBlock Text="Advanced (raw DS402 transitions):" Foreground="Gray" Margin="0,0,0,4" />
                    <Button Content="Shutdown" Margin="2" Padding="6,4" Command="{Binding ShutdownCommand}" />
                    <Button Content="Switch On" Margin="2" Padding="6,4" Command="{Binding SwitchOnCommand}" />
                    <Button Content="Enable Operation" Margin="2" Padding="6,4" Command="{Binding EnableOperationCommand}" />
                    <Button Content="Disable Voltage" Margin="2" Padding="6,4" Command="{Binding DisableVoltageCommand}" />
                    <Button Content="Fault Reset" Margin="2" Padding="6,4" Command="{Binding FaultResetCommand}" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Row 6: jog (Cyclic Synchronous Position) for the selected slave. Hold to move, release
             to stop; see MainWindow.xaml.cs's Jog*_PreviewMouseLeftButton*/LostMouseCapture
             handlers and MainWindowViewModel.BeginJog/EndJog. -->
        <GroupBox Grid.Row="6" Header="Jog (CSP, position mode) -- selected slave" Margin="0,0,0,10">
            <StackPanel Margin="6">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Velocity (units/sec):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="70" Text="{Binding JogVelocity, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanJog}" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Acceleration (units/sec&#178;):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="70" Text="{Binding JogAcceleration, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanJog}" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="Deceleration (units/sec&#178;):" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="70" Text="{Binding JogDeceleration, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanJog}" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="JogNegativeButton" Content="&#9664; Jog" Padding="18,6" Margin="0,0,6,0"
                            IsEnabled="{Binding CanJog}" Tag="-1"
                            PreviewMouseLeftButtonDown="JogButton_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="JogButton_PreviewMouseLeftButtonUp"
                            LostMouseCapture="JogButton_LostMouseCapture" />
                    <Button x:Name="JogPositiveButton" Content="Jog &#9654;" Padding="18,6" Margin="0,0,16,0"
                            IsEnabled="{Binding CanJog}" Tag="1"
                            PreviewMouseLeftButtonDown="JogButton_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="JogButton_PreviewMouseLeftButtonUp"
                            LostMouseCapture="JogButton_LostMouseCapture" />
                    <TextBlock VerticalAlignment="Center" Foreground="Gray" TextWrapping="Wrap" MaxWidth="380"
                               Text="Hold to move, release to decelerate to a stop. No unit scaling in this milestone (raw encoder counts, not mm/RPM) -- start with a small velocity and increase gradually while watching the real motor." />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Row 7: scrolling log -->
        <GroupBox Grid.Row="7" Header="Log">
            <ListBox x:Name="LogListBox" ItemsSource="{Binding LogEntries}" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Bound directly to the LogEntry item (no Path), so WPF falls back to
                             LogEntry.ToString(), which formats "[HH:mm:ss.fff] message". -->
                        <TextBlock Text="{Binding Mode=OneWay}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</Window>
